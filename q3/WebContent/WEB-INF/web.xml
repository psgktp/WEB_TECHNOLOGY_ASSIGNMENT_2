<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Student Front-End Portal</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- SameSite protection in modern containers -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Authentication and Security Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.studentportal.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/students</url-pattern>
        <url-pattern>/student-detail</url-pattern>
        <url-pattern>/stream-file</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentPortalServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.StudentPortalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentPortalServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentDetailServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.StudentDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDetailServlet</servlet-name>
        <url-pattern>/student-detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FileStreamServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.FileStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FileStreamServlet</servlet-name>
        <url-pattern>/stream-file</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

</web-app>
